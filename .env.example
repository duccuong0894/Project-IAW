# Copy thành .env rồi điền giá trị thật trước khi chạy docker-compose.prod.yml
# KHÔNG commit file .env (đã có trong .gitignore).

# Domain đã trỏ A record về IP của VPS này
DOMAIN=antiqua.example.com

# Email nhận cảnh báo hết hạn chứng chỉ Let's Encrypt
ACME_EMAIL=you@example.com

# Tài khoản basic-auth dùng chung cho lớp/đội thi (chắn trước toàn bộ site)
BASIC_AUTH_USER=student

# Tạo bằng: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'mat-khau-cua-ban'
BASIC_AUTH_HASH=$2a$14$REPLACE_WITH_GENERATED_BCRYPT_HASH
